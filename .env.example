APP_NAME=app-eevee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# IP 制限の拒否などのセキュリティログの出力先（security_file = storage/logs/security-*.log、Laravel Cloud では stderr）
LOG_SECURITY_CHANNELS=security_file

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eevee
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# キーの接頭辞（APP_NAME を変えてもキーが変わらないよう固定）
REDIS_PREFIX=eevee-
# マネージドの Valkey / Redis で TLS が必要なら tls
REDIS_SCHEME=
# キャッシュ用の DB 番号。DB 0 しか使えないサービスでは 0 にする（接頭辞でキーは分かれる）
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@app-eevee.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# app-eevee
# ---------------------------------------------------------------------------
# 表示に使う既定のタイムゾーン（保存は常にUTC）
EEVEE_DEFAULT_TIMEZONE=Asia/Tokyo

# ロードバランサー / Cloudflare など、X-Forwarded-For を信頼するプロキシ（カンマ区切りのIP/CIDR、または *）
# 詳細は docs/deployment.md を参照
TRUSTED_PROXIES=

# システム管理画面（/system）にアクセスできるIP/CIDR（カンマ区切り）。
# 管理画面からDBにも追加できる。両方とも空なら制限なし。
SYSTEM_IP_ALLOWLIST=

# API レート制限（1分あたり）
EEVEE_RATE_LIMIT_PER_APP=6000
EEVEE_RATE_LIMIT_PER_IP=300
EEVEE_RATE_LIMIT_SERVER_PER_APP=1200

# Horizon を使うか（Laravel Cloud のマネージドキューでは false）
EEVEE_HORIZON_ENABLED=true

# プッシュ配信
# プッシュ送信ジョブのキュー名。ワーカーがこのキューと default を処理すること
EEVEE_PUSH_QUEUE=push
EEVEE_PUSH_CHUNK_SIZE=500
# true にすると FCM に送らず、送信内容をログに出す（ローカル開発用）
EEVEE_PUSH_FAKE=false

# 動画（Cloudflare Stream）
EEVEE_VIDEO_HEARTBEAT_TIMEOUT=90
# true にすると Cloudflare API を呼ばずにダミー応答を返す（ローカル開発用）
EEVEE_VIDEO_FAKE=false
# EEVEE_VIDEO_FAKE=true のときに再生 API が返す HLS（既定は公開のテスト用ストリーム）
# EEVEE_VIDEO_FAKE_HLS_URL=

VITE_APP_NAME="${APP_NAME}"
