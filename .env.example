APP_NAME=app-eevee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eevee
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@app-eevee.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# app-eevee
# ---------------------------------------------------------------------------
# 表示に使う既定のタイムゾーン（保存は常にUTC）
EEVEE_DEFAULT_TIMEZONE=Asia/Tokyo

# ロードバランサー / Cloudflare など、X-Forwarded-For を信頼するプロキシ（カンマ区切りのIP/CIDR、または *）
# 詳細は docs/deployment.md を参照
TRUSTED_PROXIES=

# システム管理画面（/system）にアクセスできるIP/CIDR（カンマ区切り）。
# 管理画面からDBにも追加できる。両方とも空なら制限なし。
SYSTEM_IP_ALLOWLIST=

# API レート制限（1分あたり）
EEVEE_RATE_LIMIT_PER_APP=6000
EEVEE_RATE_LIMIT_PER_IP=300
EEVEE_RATE_LIMIT_SERVER_PER_APP=1200

# プッシュ配信
EEVEE_PUSH_CHUNK_SIZE=500
# true にすると FCM に送らず、送信内容をログに出す（ローカル開発用）
EEVEE_PUSH_FAKE=false

# 動画（Cloudflare Stream）
EEVEE_VIDEO_HEARTBEAT_TIMEOUT=90
# true にすると Cloudflare API を呼ばずにダミー応答を返す（ローカル開発用）
EEVEE_VIDEO_FAKE=false

VITE_APP_NAME="${APP_NAME}"
